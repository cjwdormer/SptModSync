<Project>

  <PropertyGroup>
    <!--
      Stack traces embed the absolute path of every source file as it existed on the build machine,
      which is how "C:\Users\<name>\OneDrive\Desktop\..." ends up in a log shipped to other people.
      PathMap rewrites those to repo-relative paths at compile time, so a trace reads
      "./src/TCFModSync.Client/Sync/SyncClient.cs:43" instead of exposing the developer's folder
      layout, account name, and cloud storage setup.

      Line numbers are kept - they've been genuinely useful for diagnosing this mod - so this hides
      the path without giving up the diagnostics.

      This file lives in build/, one level below the repo root, so the mapped prefix has to be the
      *parent* of this file's own directory (the repo root), not MSBuildThisFileDirectory itself -
      otherwise the prefix would never match a source path and this would silently do nothing.
    -->
    <PathMap>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\'))=./</PathMap>

    <!--
      Makes builds reproducible: the same source produces the same binary regardless of machine or
      directory. Also stops absolute paths sneaking back in through other compiler-embedded metadata.
    -->
    <Deterministic>true</Deterministic>

    <!--
      NuGet.config lives right next to this file in build/, not the repo root, so it's outside the
      directory-walk-up NuGet normally uses to auto-discover it. This property is the supported way
      to redirect that discovery - dotnet restore / dotnet build / VS's PackageReference restore all
      honor it, so "just restore, it works" (see BUILD.md) stays true without a config file at the
      root.
    -->
    <RestoreConfigFile>$(MSBuildThisFileDirectory)NuGet.config</RestoreConfigFile>
  </PropertyGroup>

  <!--
    SptInstallDir points at each developer's own SPT game folder (e.g. "E:\Single Player Tarkov"),
    used by TCFModSync.Client.csproj to find BepInEx/UnityEngine/spt-common DLLs that can't be
    redistributed via NuGet. That path is personal machine layout, not project source, so it must
    never be hardcoded in a file that gets committed.

    Resolution order:
      1. An environment variable, SPT_INSTALL_DIR - handy for CI or a quick one-off override.
      2. Directory.Build.local.props, sitting next to this file - gitignored, so each developer
         keeps their own copy. Copy Directory.Build.local.props.example to create it.
    If neither is set, SptInstallDir stays empty and the Client csproj raises a clear build error
    instead of silently failing to find the DLLs.
  -->
  <PropertyGroup>
    <SptInstallDir Condition="'$(SptInstallDir)' == ''">$(SPT_INSTALL_DIR)</SptInstallDir>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Directory.Build.local.props"
          Condition="Exists('$(MSBuildThisFileDirectory)Directory.Build.local.props')" />

</Project>
