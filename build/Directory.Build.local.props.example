<Project>

  <!--
    Copy this file to Directory.Build.local.props (same folder) and set SptInstallDir to your own
    SPT game install. Directory.Build.local.props is gitignored - it never leaves your machine.
  -->
  <PropertyGroup>
    <SptInstallDir>E:\Single Player Tarkov</SptInstallDir>
  </PropertyGroup>

</Project>
