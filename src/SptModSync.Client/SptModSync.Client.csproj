<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SptModSync.Client</RootNamespace>
    <AssemblyName>SptModSync.Client</AssemblyName>
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.2" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!--
    SptInstallDir comes from build/Directory.Build.props (env var SPT_INSTALL_DIR, or a gitignored
    build/Directory.Build.local.props - see build/Directory.Build.local.props.example). Fail fast
    with a clear message rather than a confusing "file not found" from the compiler.
  -->
  <Target Name="CheckSptInstallDir" BeforeTargets="BeforeBuild">
    <Error Condition="'$(SptInstallDir)' == ''"
           Text="SptInstallDir is not set. Copy build/Directory.Build.local.props.example to build/Directory.Build.local.props and set it to your SPT install folder (or set the SPT_INSTALL_DIR environment variable)." />
  </Target>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(SptInstallDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine">
      <HintPath>$(SptInstallDir)\EscapeFromTarkov_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(SptInstallDir)\EscapeFromTarkov_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.IMGUIModule">
      <HintPath>$(SptInstallDir)\EscapeFromTarkov_Data\Managed\UnityEngine.IMGUIModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!--
      SPT's own client assembly, shipped with the game in BepInEx\plugins\spt\. Provides
      SPT.Common.Http.RequestHandler, which already knows the server address, holds the session, and
      handles SPT's self-signed certificate - so syncing works wherever the game works, with no
      separate port or address to configure.

      <Private>false</Private> matters: the game loads its own copy, and shipping a second one in the
      plugin folder would conflict with it.
    -->
    <Reference Include="spt-common">
      <HintPath>$(SptInstallDir)\BepInEx\plugins\spt\spt-common.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SptModSync.Shared\SptModSync.Shared.csproj" />
  </ItemGroup>

</Project>
