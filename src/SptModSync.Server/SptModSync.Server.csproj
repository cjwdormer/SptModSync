<!-- Web SDK, not the plain library SDK: implementing SPT's IHttpListener means handling a raw
     ASP.NET Core HttpContext, which needs the framework reference this SDK brings in. -->
<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>SptModSync.Server</RootNamespace>
    <AssemblyName>SptModSync.Server</AssemblyName>
    <!-- Matches the layout SPT's mod loader expects: bin\Release\<AssemblyName>\ -->
    <OutputPath>bin\$(Configuration)\$(AssemblyName)\</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <!-- Libraries don't copy NuGet deps to output by default, but an SPT mod folder has to be
         self-contained - System.IO.Hashing in particular is not part of the base runtime. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pin these to whatever your local SPT 4.0.13 server actually ships - check
         %SPTserver%\SPT\SPTarkov.Server.Core.dll's version if NuGet's "latest" ever drifts. -->
    <!-- ExcludeAssets="runtime" is important now that CopyLocalLockFileAssemblies is on: the server
         already loads its own copies of these, and shipping duplicates in the mod folder risks
         type-identity conflicts. Compile against them, don't redistribute them. -->
    <PackageReference Include="SPTarkov.Common" Version="4.0.13" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.DI" Version="4.0.13" ExcludeAssets="runtime" />
    <PackageReference Include="SPTarkov.Server.Core" Version="4.0.13" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SptModSync.Shared\SptModSync.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="config\serverConfig.default.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
